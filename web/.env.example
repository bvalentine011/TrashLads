# Copy to .env.local and fill in from the Firebase console (Project settings → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (the payment functions require App Check).
VITE_APPCHECK_SITE_KEY=
# Stripe publishable key. Must be pk_test_ until go-live (see README).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
VITE_LIVE_PAYMENTS_ENABLED=false
